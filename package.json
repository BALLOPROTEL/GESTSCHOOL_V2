{
  "name": "gestschool",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev:api": "pnpm --filter @gestschool/api start:dev",
    "dev:worker": "pnpm --filter @gestschool/api start:worker:dev",
    "dev:web": "pnpm --filter @gestschool/web-admin dev",
    "build:api": "pnpm --filter @gestschool/api build",
    "build:web": "pnpm --filter @gestschool/web-admin build",
    "visual:audit:core": "node scripts/visual-audit-core-workflows.mjs",
    "visual:audit:mocked": "VISUAL_AUDIT_MODE=mocked node scripts/visual-audit-core-workflows.mjs",
    "visual:audit:integrated": "VISUAL_AUDIT_MODE=integrated node scripts/visual-audit-core-workflows.mjs",
    "visual:audit:test": "node scripts/visual-audit/lib/audit-guard.test.mjs",
    "visual:audit:lint": "node --check scripts/visual-audit-core-workflows.mjs && node --check scripts/visual-audit/lib/audit-guard.mjs && node --check scripts/visual-audit/fixtures/mock-api-v1.mjs",
    "render:build:api": "pnpm --filter @gestschool/api prisma:generate && pnpm --filter @gestschool/api db:migrate:deploy && pnpm --filter @gestschool/api build",
    "render:start:api": "pnpm --filter @gestschool/api start:prod",
    "render:start:worker": "pnpm --filter @gestschool/api start:worker",
    "lint": "pnpm lint:api && pnpm lint:web",
    "build": "pnpm build:api && pnpm build:web",
    "lint:api": "pnpm --filter @gestschool/api lint",
    "lint:web": "pnpm --filter @gestschool/web-admin lint"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.6",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "fast-uri@<=3.1.1": "3.1.2",
      "flatted@<=3.4.1": "3.4.2",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.10": "8.5.10",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "undici@>=7.0.0 <7.28.0": "7.28.0"
    }
  }
}
