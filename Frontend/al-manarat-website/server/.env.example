PORT=3001
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:3001

# Use a long random value in production.
JWT_SECRET=change-me-with-a-long-random-secret
CMS_ADMIN_EMAIL=admin@almanarat.sn
CMS_ADMIN_PASSWORD=change-me-before-production

# Comma-separated allowed origins in production, for example:
# CORS_ORIGIN=https://almanarat.example.com,https://www.almanarat.example.com
CORS_ORIGIN=*

# Single-domain routing targets.
GESTSCHOOL_BASE_PATH=/gestion
SITE_API_BASE_PATH=/api/site

# URL used to seed settings.gestschool_url on first start.
# In production single-domain mode, prefer the relative path below.
GESTSCHOOL_URL=/gestion/login

# MongoDB Atlas CMS target. Keep secrets out of Git.
# Example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=AlManaratDB
MONGODB_APP_NAME=al-manarat-website

# Set to true in production once Atlas is mandatory.
MONGODB_REQUIRED=false
